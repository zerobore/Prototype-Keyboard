<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: even though allowBackup=false, exclude everything
     (learned words, settings) from auto-backup. User backup is explicit
     export/import only (Phase 3). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
